# Copy to .env.local for `vercel dev`. Never commit real values.

# Core
GOOGLE_PLACES_API_KEY=
APP_PASSWORD=            # owner master key (unlimited access)
DATABASE_URL=            # Postgres (Neon / Vercel Postgres)
SITE_URL=https://coaihq.online

# Cron jobs (Vercel sends "Authorization: Bearer <CRON_SECRET>"; unset = all crons refuse)
CRON_SECRET=

# Email (password reset + cron outreach). Gmail App Password.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
OUTREACH_POSTAL_ADDRESS= # required by CAN-SPAM in cold outreach footer

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_URL_SECRET=
STRIPE_WEBHOOK_SECRET=   # optional signing secret

# Square (optional)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_PLAN_VARIATION_STARTER=
SQUARE_PLAN_VARIATION_PRO=
SQUARE_WEBHOOK_URL_SECRET=
SQUARE_SIGNATURE_KEY=

# AI outreach (any one)
AI_PROVIDER=gemini
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# Scraper escalation (optional)
PROXY_USERNAME=
PROXY_PASSWORD=
CAPSOLVER_API_KEY=

# Local Python tools only
COAI_PASSWORD=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
